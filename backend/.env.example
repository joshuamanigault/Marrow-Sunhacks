# Server bind address (used by the documented uvicorn command).
HOST=127.0.0.1
PORT=8000

# Comma-separated browser origins allowed by CORS (frontend Vite default).
# Example: CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Prepared specimen assets (manifest.json + meshes/). Defaults to <repo>/data/prepared.
# ASSETS_DIR=C:\Users\spart\Documents\Projects\Marrow\data\prepared

# Optional — leave blank for local health checks and startup.
# PostgreSQL / Tiger Data connection string (server-side only).
DATABASE_URL=

# Optional — Gemini (server-side only). Not required to start the API.
# With a key, the Ask panel (explain / guided tour / follow-up) turns on; see docs/api/ai-contract.md.
# GEMINI_MODEL defaults to gemini-3.5-flash-lite when blank.
GEMINI_API_KEY=
GEMINI_MODEL=
